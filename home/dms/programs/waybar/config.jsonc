{
    "layer": "top",
    "position": "top",
    "height": 34,

    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,

    "modules-left": [
        "clock",
        "hyprland/workspaces"
    ],

    "modules-center": [
        "hyprland/window"
    ],

    "modules-right": [
        "cpu",
        "memory",
        "pulseaudio",
        "network",
        "battery"
        
    ],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "active-only": false
    },

    "hyprland/window": {
        "format": "{}",
        "separate-outputs": true,
        "max-length": 60
    },

    "cpu": {
        "interval": 5,
        "format": "󰻠  {usage}%"
    },

    "memory": {
        "interval": 5,
        "format": "󰍛  {percentage}%"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰝟  muted",
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol"
    },

    "network": {
        "format-wifi": "󰖩  {essid}",
        "format-ethernet": "󰈀  connected",
        "format-disconnected": "󰖪  offline",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-plugged": "󰚥  {capacity}%",
        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ]
    },

    "clock": {
        "format": "󰥔  {:%H:%M}",
        "tooltip-format": "{:%A, %d %B %Y}"
    }
}